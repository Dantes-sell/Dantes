@page
@model DantesUidSite.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="form-card">
    <h2 class="mb-3">Login</h2>

    @if (Model.Registered)
    {
        <div class="alert alert-success">
            Account created successfully. Your UID: <strong>@Model.NewUid</strong>
        </div>
    }

    <p class="text-light-emphasis">Use email or login, and your password.</p>

    <form method="post" class="mt-3">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Input.Identifier" class="form-label"></label>
            <input asp-for="Input.Identifier" class="form-control" />
            <span asp-validation-for="Input.Identifier" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}