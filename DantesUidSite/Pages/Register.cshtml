@page
@model DantesUidSite.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="form-card">
    <h2 class="mb-3">Create Account</h2>
    <p class="text-light-emphasis">Register with email, login and password.</p>

    <form method="post" class="mt-3">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Login" class="form-label"></label>
            <input asp-for="Input.Login" class="form-control" />
            <span asp-validation-for="Input.Login" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Register</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}